{
  "entities": {
    "Event": {
      "title": "Event",
      "description": "A workshop, seminar, meeting, or professional development session with an active QR check-in.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140,
          "description": "Display name of the workshop, seminar, or session."
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Customizable session type."
        },
        "description": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional agenda or facilitator note."
        },
        "venue": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Room, hall, or online meeting location."
        },
        "city": {
          "type": "string",
          "maxLength": 80,
          "description": "City where the event is held (printed above signature block and synced to certificates)."
        },
        "eventDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Scheduled date in YYYY-MM-DD format."
        },
        "startTime": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^[0-9]{2}:[0-9]{2}$",
          "description": "Scheduled start time in 24-hour HH:MM format."
        },
        "lateCutoffTime": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^[0-9]{2}:[0-9]{2}$",
          "description": "Cutoff time in 24-hour HH:MM format after which check-ins are marked Late."
        },
        "cutoffTimestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Exact cutoff timestamp for On Time vs Late classification."
        },
        "status": {
          "type": "string",
          "enum": ["active", "closed"],
          "description": "Whether the session is currently accepting participant check-ins."
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the administrator who created the event."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the event was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the event was last updated."
        },
        "departmentLabel": {
          "type": "string",
          "maxLength": 80,
          "description": "Custom label for the Class / Department field on the participant form."
        },
        "departmentPresets": {
          "type": "string",
          "maxLength": 300,
          "description": "Comma-separated quick-select department or class options."
        },
        "consentText": {
          "type": "string",
          "maxLength": 400,
          "description": "Custom photo consent statement shown to participants."
        },
        "facilitators": {
          "type": "string",
          "maxLength": 200,
          "description": "Facilitator name(s) printed on participant recognition certificates."
        },
        "picTitle": {
          "type": "string",
          "maxLength": 120,
          "description": "PIC of (Event) signatory role title synced to all certificate templates."
        },
        "picName": {
          "type": "string",
          "maxLength": 120,
          "description": "PIC of (Event) signatory name synced to all certificate templates."
        },
        "principalName": {
          "type": "string",
          "maxLength": 120,
          "description": "Principal name printed on participant recognition certificates."
        },
        "requireParticipantLogin": {
          "type": "boolean",
          "description": "When true, participants must sign in with a Google email before submitting check-in."
        },
        "theme": {
          "type": "string",
          "maxLength": 120,
          "description": "Optional event theme displayed on certificates and feedback forms."
        },
        "topic": {
          "type": "string",
          "maxLength": 200,
          "description": "Optional session topic or focus area."
        }
      },
      "required": [
        "title",
        "category",
        "description",
        "venue",
        "eventDate",
        "startTime",
        "lateCutoffTime",
        "cutoffTimestamp",
        "status",
        "createdByUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "A participant attendance submission recorded with or without participant login depending on session settings.",
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "ID of the parent Event document."
        },
        "eventName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140,
          "description": "Snapshot of the event title at check-in time."
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Participant full name."
        },
        "classDepartment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Participant class, grade, or department."
        },
        "photoDataUrl": {
          "type": "string",
          "minLength": 30,
          "maxLength": 250000,
          "description": "Compressed participant photo encoded as an image data URL."
        },
        "photoConsent": {
          "type": "boolean",
          "description": "Explicit participant consent for photo use."
        },
        "attendanceDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Attendance date in YYYY-MM-DD format."
        },
        "checkInTime": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "description": "Formatted check-in clock time."
        },
        "serverTimestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Authoritative Firestore server timestamp."
        },
        "status": {
          "type": "string",
          "enum": ["On Time", "Late"],
          "description": "Attendance timeliness status."
        },
        "lateExcuse": {
          "type": "string",
          "maxLength": 300,
          "description": "Participant explanation for late arrival (required when status is Late)."
        },
        "participantEmail": {
          "type": "string",
          "maxLength": 128,
          "description": "Verified Google email of the participant when the session requires participant login."
        },
        "participantUid": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase UID of the participant when the session requires participant login."
        }
      },
      "required": [
        "eventId",
        "eventName",
        "fullName",
        "classDepartment",
        "photoDataUrl",
        "photoConsent",
        "attendanceDate",
        "checkInTime",
        "serverTimestamp",
        "status",
        "lateExcuse"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized administrator document.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "addedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "addedByUid", "createdAt"]
    },
    "DashboardSetting": {
      "title": "DashboardSetting",
      "description": "Administrator live dashboard background configuration.",
      "type": "object",
      "properties": {
        "backgroundDataUrl": {
          "type": "string",
          "minLength": 30,
          "maxLength": 450000,
          "description": "JPEG data URL used as the live dashboard portrait background."
        },
        "backgroundOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Background photo visibility percentage (0 to 100)."
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["backgroundDataUrl", "updatedByUid", "updatedAt"]
    },
    "OrganizationBranding": {
      "title": "OrganizationBranding",
      "description": "School or company name and uploaded logo displayed in the top-left header, QR board, and exports.",
      "type": "object",
      "properties": {
        "organizationName": {
          "type": "string",
          "maxLength": 120,
          "description": "School or company name shown next to the logo in the top-left position."
        },
        "logoDataUrl": {
          "type": "string",
          "maxLength": 350000,
          "description": "Compressed PNG, JPEG, or WebP data URL of the school or company logo."
        },
        "publicAppUrl": {
          "type": "string",
          "maxLength": 250,
          "description": "Public HTTPS production origin (e.g. Vercel URL) encoded inside generated QR codes."
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["organizationName", "logoDataUrl", "updatedByUid", "updatedAt"]
    },
    "AuthorizedAdmin": {
      "title": "AuthorizedAdmin",
      "description": "Email-based administrator and teacher allowlist entry.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "minLength": 5,
          "maxLength": 128,
          "pattern": "^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$",
          "description": "Normalized lowercase Google email address authorized to access the Admin Console."
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "Optional teacher or administrator name or role label."
        },
        "addedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the administrator who added this email."
        },
        "addedByEmail": {
          "type": "string",
          "minLength": 5,
          "maxLength": 128,
          "pattern": "^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$",
          "description": "Email address of the administrator who added this email."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the administrator email was authorized."
        }
      },
      "required": ["email", "displayName", "addedByUid", "addedByEmail", "createdAt"]
    },
    "CertificateSetting": {
      "title": "CertificateSetting",
      "description": "Administrator certificate theme, element visibility & position layout, background opacity, and digital signatures.",
      "type": "object",
      "properties": {
        "themeId": {
          "type": "string",
          "enum": [
            "classic-navy",
            "emerald-academic",
            "royal-slate",
            "crimson-crest",
            "teal-modern"
          ],
          "description": "Selected visual template theme for generated PDF certificates."
        },
        "backgroundDataUrl": {
          "type": "string",
          "maxLength": 340000,
          "description": "Optional compressed background image data URL rendered behind the certificate content."
        },
        "backgroundOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Certificate background photo opacity percentage (0 to 100)."
        },
        "facilitatorSignatureDataUrl": {
          "type": "string",
          "maxLength": 150000,
          "description": "Optional transparent PNG/image data URL of the facilitator digital signature."
        },
        "principalSignatureDataUrl": {
          "type": "string",
          "maxLength": 150000,
          "description": "Optional transparent PNG/image data URL of the principal digital signature."
        },
        "picPdName": {
          "type": "string",
          "maxLength": 120,
          "description": "Customizable name printed above the PIC of Professional Development signature line."
        },
        "picPdTitle": {
          "type": "string",
          "maxLength": 120,
          "description": "Signatory role title (defaults to PIC of Professional Development)."
        },
        "principalName": {
          "type": "string",
          "maxLength": 120,
          "description": "Customizable name printed above the Principal signature line."
        },
        "principalTitle": {
          "type": "string",
          "maxLength": 120,
          "description": "Signatory role title (defaults to Principal)."
        },
        "cityName": {
          "type": "string",
          "maxLength": 80,
          "description": "City printed above the Principal signature date line (defaults to Jakarta)."
        },
        "bestTerm": {
          "type": "string",
          "enum": ["none", "term1", "term2", "term3", "term4"],
          "description": "Optional active academic term for Best Category certificate recognition."
        },
        "termBestCategories": {
          "type": "object",
          "description": "Customizable Best Category labels for Term 1 through Term 4."
        },
        "elements": {
          "type": "object",
          "description": "Visibility and (x, y) position in mm for each certificate element."
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "themeId",
        "backgroundDataUrl",
        "backgroundOpacity",
        "facilitatorSignatureDataUrl",
        "principalSignatureDataUrl",
        "elements",
        "updatedByUid",
        "updatedAt"
      ]
    },
    "FeedbackConfig": {
      "title": "FeedbackConfig",
      "description": "Customizable participant feedback questions, menu statements, rating areas, categories, checklist statements, and submission schedule per event or global default.",
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "formHeading": { "type": "string", "maxLength": 120 },
        "introNote": { "type": "string", "maxLength": 400 },
        "ratingSectionTitle": { "type": "string", "maxLength": 140 },
        "ratingSectionSubtitle": { "type": "string", "maxLength": 300 },
        "checklistSectionTitle": { "type": "string", "maxLength": 140 },
        "checklistSectionSubtitle": { "type": "string", "maxLength": 300 },
        "commentQuestionLabel": { "type": "string", "maxLength": 160 },
        "commentPlaceholder": { "type": "string", "maxLength": 240 },
        "requireWrittenComment": { "type": "boolean" },
        "allowAttachment": { "type": "boolean" },
        "requireAttachment": { "type": "boolean" },
        "attachmentLabel": { "type": "string", "maxLength": 160 },
        "ratingCriteria": { "type": "array", "maxItems": 12 },
        "categories": { "type": "array", "maxItems": 12 },
        "statements": { "type": "array", "maxItems": 40 },
        "customQuestions": { "type": "array", "maxItems": 6 },
        "feedbackActive": { "type": "boolean" },
        "scheduleEnabled": { "type": "boolean" },
        "openAtIso": { "type": "string", "maxLength": 40 },
        "closeAtIso": { "type": "string", "maxLength": 40 },
        "openTimestamp": { "type": "string", "format": "date-time" },
        "closeTimestamp": { "type": "string", "format": "date-time" },
        "scheduleClosedMessage": { "type": "string", "maxLength": 300 },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "eventId",
        "introNote",
        "requireWrittenComment",
        "ratingCriteria",
        "categories",
        "statements",
        "updatedByUid",
        "updatedAt"
      ]
    },
    "FeedbackSubmission": {
      "title": "FeedbackSubmission",
      "description": "Participant feedback & evaluation response linked to an active event.",
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "eventTitle": { "type": "string", "minLength": 2, "maxLength": 140 },
        "eventDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "eventVenue": { "type": "string", "maxLength": 120 },
        "facilitatorName": { "type": "string", "maxLength": 200 },
        "sessionTopic": { "type": "string", "maxLength": 200 },
        "ratings": { "type": "array", "maxItems": 12 },
        "averageRating": { "type": "number", "minimum": 0, "maximum": 5 },
        "selectedStatements": { "type": "array", "maxItems": 40 },
        "writtenComment": { "type": "string", "maxLength": 1500 },
        "customAnswers": { "type": "array", "maxItems": 6 },
        "attachment": { "type": "object", "description": "Optional metadata for a supporting PDF, JPEG photo, or MP4/MOV video stored in feedbackAttachments." },
        "participantName": { "type": "string", "maxLength": 100 },
        "participantDepartment": { "type": "string", "maxLength": 100 },
        "participantEmail": { "type": "string", "maxLength": 128 },
        "attendanceId": { "type": "string", "maxLength": 128 },
        "clientSubmissionToken": {
          "type": "string",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "serverTimestamp": { "type": "string", "format": "date-time" }
      },
      "required": [
        "eventId",
        "eventTitle",
        "eventDate",
        "eventVenue",
        "facilitatorName",
        "sessionTopic",
        "ratings",
        "averageRating",
        "selectedStatements",
        "writtenComment",
        "clientSubmissionToken",
        "serverTimestamp"
      ]
    },
    "FeedbackAttachment": {
      "title": "FeedbackAttachment",
      "description": "Metadata for an uploaded PDF, JPEG photo, or MP4/MOV video linked to a feedback submission.",
      "type": "object",
      "properties": {
        "submissionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "eventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 180 },
        "mimeType": {
          "type": "string",
          "enum": ["application/pdf", "image/jpeg", "video/mp4", "video/quicktime"]
        },
        "fileCategory": {
          "type": "string",
          "enum": ["pdf", "image", "video"]
        },
        "byteSize": { "type": "number", "minimum": 1, "maximum": 5242880 },
        "chunkCount": { "type": "number", "minimum": 1, "maximum": 24 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "submissionId",
        "eventId",
        "fileName",
        "mimeType",
        "fileCategory",
        "byteSize",
        "chunkCount",
        "createdAt"
      ]
    },
    "FeedbackAttachmentChunk": {
      "title": "FeedbackAttachmentChunk",
      "description": "Bounded base64 slice of a participant feedback attachment stored under feedbackAttachments/{attachmentId}/chunks.",
      "type": "object",
      "properties": {
        "submissionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "eventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chunkIndex": { "type": "number", "minimum": 0, "maximum": 23 },
        "data": { "type": "string", "minLength": 1, "maxLength": 350000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["submissionId", "eventId", "chunkIndex", "data", "createdAt"]
    },
    "RecognitionCategory": {
      "title": "RecognitionCategory",
      "description": "Customizable recognition award category created by administrators.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 300 },
        "sortOrder": { "type": "number", "minimum": 0, "maximum": 1000 },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "description", "sortOrder", "createdByUid", "createdAt", "updatedAt"]
    },
    "RecognitionTemplate": {
      "title": "RecognitionTemplate",
      "description": "Editable portrait/landscape certificate designer template for participant recognition.",
      "type": "object",
      "properties": {
        "orientation": { "type": "string", "enum": ["landscape", "portrait"] },
        "title": { "type": "string", "minLength": 2, "maxLength": 120 },
        "subtitle": { "type": "string", "maxLength": 140 },
        "wordingTemplate": { "type": "string", "minLength": 5, "maxLength": 600 },
        "fontFamily": { "type": "string", "enum": ["times", "helvetica", "courier"] },
        "primaryColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "accentColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "paperColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "customLogoDataUrl": { "type": "string", "maxLength": 320000 },
        "signatureDataUrl": { "type": "string", "maxLength": 150000 },
        "signatoryLabel": { "type": "string", "maxLength": 120 },
        "bestTerm": {
          "type": "string",
          "enum": ["none", "term1", "term2", "term3", "term4"]
        },
        "termBestCategories": { "type": "object" },
        "picPdName": { "type": "string", "maxLength": 120 },
        "picPdTitle": { "type": "string", "maxLength": 120 },
        "picPdSignatureDataUrl": { "type": "string", "maxLength": 150000 },
        "principalName": { "type": "string", "maxLength": 120 },
        "principalTitle": { "type": "string", "maxLength": 120 },
        "principalSignatureDataUrl": { "type": "string", "maxLength": 150000 },
        "cityName": { "type": "string", "maxLength": 80 },
        "showTopic": { "type": "boolean" },
        "showFacilitator": { "type": "boolean" },
        "showCertificateId": { "type": "boolean" },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "orientation",
        "title",
        "subtitle",
        "wordingTemplate",
        "fontFamily",
        "primaryColor",
        "accentColor",
        "paperColor",
        "customLogoDataUrl",
        "signatureDataUrl",
        "signatoryLabel",
        "showTopic",
        "showFacilitator",
        "showCertificateId",
        "updatedByUid",
        "updatedAt"
      ]
    },
    "ParticipationTemplate": {
      "title": "ParticipationTemplate",
      "description": "Editable English, Bahasa Indonesia, or Bilingual certificate of participation template automatically provided to all event participants.",
      "type": "object",
      "properties": {
        "languageFormat": {
          "type": "string",
          "enum": ["bilingual", "english", "bahasa"]
        },
        "orientation": { "type": "string", "enum": ["landscape", "portrait"] },
        "fontFamily": { "type": "string", "enum": ["times", "helvetica", "courier"] },
        "primaryColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
