  "firestore": {
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/Event" },
      "description": "Workshop, seminar, meeting, and professional development sessions."
    },
    "/attendances/{attendanceId}": {
      "schema": { "$ref": "#/entities/Attendance" },
      "description": "Participant attendance submissions linked to an active event."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Legacy UID-keyed authorized administrator accounts."
    },
    "/authorizedAdmins/{adminEmail}": {
      "schema": { "$ref": "#/entities/AuthorizedAdmin" },
      "description": "Email-keyed allowlist of authorized teachers and administrators."
    },
    "/dashboardSettings/{settingId}": {
      "schema": { "$ref": "#/entities/DashboardSetting" },
      "description": "Live dashboard appearance settings controlled by administrators."
    },
    "/branding/{brandingId}": {
      "schema": { "$ref": "#/entities/OrganizationBranding" },
      "description": "School or company logo and display name controlled by administrators."
    },
    "/certificateSettings/{settingId}": {
      "schema": { "$ref": "#/entities/CertificateSetting" },
      "description": "Certificate theme, element positions/visibility, background opacity, and digital signatures managed by administrators."
    },
    "/feedbackConfigs/{configId}": {
      "schema": { "$ref": "#/entities/FeedbackConfig" },
      "description": "Customizable feedback rating criteria, categories, and checklist statements per event."
    },
    "/feedbackSubmissions/{submissionId}": {
      "schema": { "$ref": "#/entities/FeedbackSubmission" },
      "description": "Participant feedback and evaluation responses linked to an event."
    },
    "/feedbackAttachments/{attachmentId}": {
      "schema": { "$ref": "#/entities/FeedbackAttachment" },
      "description": "Supporting PDF, JPEG photo, and MP4/MOV video attachment metadata linked to feedback submissions."
    },
    "/feedbackAttachments/{attachmentId}/chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/FeedbackAttachmentChunk" },
      "description": "Bounded base64 file chunks for feedback supporting attachments."
    },
    "/recognitionCategories/{categoryId}": {
      "schema": { "$ref": "#/entities/RecognitionCategory" },
      "description": "Customizable participant recognition award categories."
    },
    "/recognitionTemplates/{templateId}": {
      "schema": { "$ref": "#/entities/RecognitionTemplate" },
      "description": "Recognition certificate designer template settings (orientation, fonts, colors, wording, logo, signature)."
    },
    "/participationTemplates/{templateId}": {
      "schema": { "$ref": "#/entities/ParticipationTemplate" },
      "description": "English, Bahasa Indonesia, and Bilingual certificate of participation template settings for automatic participant downloads and admin batch PDF exports."
    },
    "/certificates/{certificateId}": {
      "schema": { "$ref": "#/entities/IssuedCertificate" },
      "description": "Issued participant recognition certificates keyed deterministically to prevent duplicates."
    },
    "/voiceSettings/{settingId}": {
      "schema": { "$ref": "#/entities/VoiceSetting" },
      "description": "AI Voice Check-In Announcement settings configured by administrators."
    },
    "/liveBoardSettings/{settingId}": {
      "schema": { "$ref": "#/entities/LiveBoardSetting" },
      "description": "Live Animated Attendance Dashboard layout, theme, pagination, and animation configuration managed by administrators."
    },
    "/authorizedDevices/{deviceId}": {
      "schema": { "$ref": "#/entities/AuthorizedDevice" },
      "description": "Cross-device authorization & revocation audit records controlled solely by the primary owner."
    }
  }
}
