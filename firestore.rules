    match /liveBoardSettings/{settingId} {
      allow get: if isAdmin() && isValidId(settingId);
      allow list: if isAdmin();
      allow create: if isAdmin() &&
        isValidId(settingId) &&
        isValidLiveBoardSetting(incoming()) &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(settingId) &&
        isValidLiveBoardSetting(incoming()) &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'animationStyle', 'animationDurationMs', 'cardLayout',
          'columnsMode', 'manualColumns', 'photoSize', 'fontSize',
          'backgroundTheme', 'displayMode', 'rotationIntervalSec',
          'disableAnimations', 'updatedByUid', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(settingId);
    }

    match /authorizedDevices/{deviceId} {
      allow get: if isPrimaryOwner() && isValidId(deviceId);
      allow list: if isPrimaryOwner();
      allow create: if isPrimaryOwner() &&
        isValidId(deviceId) &&
        isValidAuthorizedDevice(incoming()) &&
        incoming().deviceId == deviceId &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().updatedAt == request.time;
      allow update: if isPrimaryOwner() &&
        isValidId(deviceId) &&
        isValidAuthorizedDevice(incoming()) &&
        incoming().deviceId == existing().deviceId &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'deviceName', 'userAgentSummary', 'status',
          'authorizedBy', 'authorizedAtIso', 'lastSeenAtIso', 'revokedAtIso',
          'updatedByUid', 'updatedAt'
        ]);
      allow delete: if isPrimaryOwner() && isValidId(deviceId);
    }
  }
}
